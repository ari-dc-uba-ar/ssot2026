PGHOST=127.0.0.1
PGPORT=5433
PGUSER=ssot2026_user
PGPASSWORD=ssot2026_app_local
PGDATABASE=ssot2026

# Migration owner identity and credentials, separate from the app user.
MIGRATION_PGUSER=ssot2026_owner
MIGRATION_PGPASSWORD=ssot2026_owner_local

# Initial provisioning connection, also used to initialize the PostgreSQL container.
POSTGRES_USER=ssot2026
POSTGRES_PASSWORD=ssot2026_local

# Required for JWT signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only for the one-time auth:create-admin command. Remove after creating the account.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
