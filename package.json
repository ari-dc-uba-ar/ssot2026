{
    "name": "ssot2026",
    "type": "module",
    "dependencies": {
        "express": "^5.2.1",
        "pg": "^8.23.0",
        "system-definition": "file:../system-definition",
        "@system-definition/postgres-migrations": "file:../system-definition/consumers/postgres-migrations"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.4",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "build": "tsc -p ./src/backend",
        "start": "node --env-file-if-exists=.env ./dist/backend/server",
        "db:check": "npm run build && node --env-file-if-exists=.env ./dist/backend/check-db.js",
        "db:bootstrap": "docker compose run --rm bootstrap",
        "migration:generate-initial": "npm run build && node --env-file-if-exists=.env ./dist/backend/generate-initial.js",
        "test:initial-migration": "npm run build && node --env-file-if-exists=.env --test test/initial-migration.test.mjs",
        "migration:capture": "npm run build && postgres-migrations capture --project ./dist/backend/migration-project.js"
    }
}
