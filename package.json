{
    "name": "ssot2026",
    "type": "module",
    "dependencies": {
        "express": "^5.2.1",
        "pg": "^8.23.0",
        "system-definition": "file:../system-definition",
        "@system-definition/postgres-migrations": "file:../system-definition/consumers/postgres-migrations"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.4",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "build": "tsc -b ./src/backend && tsc -p ./src/frontend",
        "start": "node --env-file-if-exists=.env ./dist/backend/server",
        "ssot:load": "npm run build && postgres-migrations capture --ssot ./dist/backend/system.js",
        "migration:load": "npm run build && postgres-migrations capture --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:assess": "npm run build && postgres-migrations assess --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:decide": "postgres-migrations resolve",
        "migration:infer": "npm run build && postgres-migrations infer --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:generate": "npm run build && postgres-migrations generate --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:data": "npm run build && postgres-migrations data --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:apply": "npm run build && postgres-migrations apply --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "migration:status": "npm run build && postgres-migrations status --ssot ./dist/backend/system.js --database ./dist/backend/database.js",
        "test:assessment": "npm run build && node --env-file-if-exists=.env --test test/assessment.test.mjs",
        "test:assembly": "npm run build && node --env-file-if-exists=.env --test test/assembly.test.mjs",
        "test:history": "npm run build && node --env-file-if-exists=.env --test test/history.test.mjs",
        "test:ssot": "npm run build && node --test test/ssot.test.mjs",
        "test:api": "npm run build && tsc -p test && node --test test/api.test.mjs",
        "test:crud": "npm run build && node --env-file-if-exists=.env --test test/crud.integration.test.mjs"
    }
}
